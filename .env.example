# =============================================================================
# CineBite Environment Configuration
# =============================================================================
# Obtain these from your Supabase Dashboard:
# 1. Go to your Supabase Project: https://supabase.com/dashboard
# 2. Click Project Settings (gear icon in sidebar) -> API (or Data API)
# 3. Copy the 'Project URL' and the 'anon' / 'public' key
#
# NOTE: NEVER copy or place the 'service_role' secret key here.

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon Key (Public client key, safe for frontend with RLS enabled)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
